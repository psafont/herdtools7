AArch64 ST1-SP
Variant=memtag,sync,neon

(* No-writeback structure store through SP is not tag-checked. *)
{
  uint64_t x[2]={0,0};
  [tag(x)]=:green;
  0:SP=x;
  0:X0=1;
  0:X1=2;
  uint128_t 0:V0.2D;
}
P0;
  MOV V0.D[0],X0;
  MOV V0.D[1],X1;
  ST1 {V0.2D},[SP];
forall(x={1,2} /\ ~fault(P0,x,TagCheck))
