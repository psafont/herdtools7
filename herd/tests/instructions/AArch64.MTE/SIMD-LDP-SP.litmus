AArch64 SIMD-LDP-SP
Variant=memtag,sync,neon

(* No-writeback SIMD pair load through SP is not tag-checked. *)
{
  uint64_t x[4]={1,2,3,4};
  [tag(x)]=:green;
  0:SP=x;
  uint64_t 0:X0;
  uint64_t 0:X1;
  uint64_t 0:X2;
  uint64_t 0:X3;
  uint128_t 0:V0.2D;
  uint128_t 0:V1.2D;
}
P0;
  LDP Q0,Q1,[SP];
  MOV X0,V0.D[0];
  MOV X1,V0.D[1];
  MOV X2,V1.D[0];
  MOV X3,V1.D[1];
forall(0:X0=1 /\ 0:X1=2 /\ 0:X2=3 /\ 0:X3=4 /\ ~fault(P0,x,TagCheck))
